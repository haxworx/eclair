/* progress_bar: visible rail, generous hit area, then draggable thumb. */
part {
   name: "progress_bar"; type: VECTOR; scale: 1; mouse_events: 0;
   description {
      state: "default" 0.0; offset_scale: 1;
      rel1 { relative: 0 0; offset: 28 83; to: "body"; }
      rel2 { relative: 0 0; offset: 282 86; to: "body"; }
      image.normal: "track.svg";
   }
}
part {
   name: "progress_bar_confine"; type: RECT; scale: 1; mouse_events: 0;
   description {
      state: "default" 0.0; offset_scale: 1; visible: 0;
      rel1 { relative: 0 0; offset: 21 78; to: "body"; }
      rel2 { relative: 0 0; offset: 289 91; to: "body"; }
   }
}
part {
   name: "progress_bar_track"; type: RECT; scale: 1;
   description {
      state: "default" 0.0; offset_scale: 1; color: 0 0 0 0;
      rel1 { to: "progress_bar_confine"; offset: 0 -3; }
      rel2 { to: "progress_bar_confine"; offset: -1 2; }
   }
}
part {
   name: "progress_bar_drag"; type: VECTOR; scale: 1;
   dragable { confine: "progress_bar_confine"; x: 1 1 1; y: 0 0 0; }
   description {
      state: "default" 0.0; offset_scale: 1;
      min: 14 14; max: 14 14;
      image.normal: "thumb.svg";
      visible: 0;
   }
   description { state: "play" 0.0; inherit: "default" 0.0; visible: 1; }
   description { state: "stop" 0.0; inherit: "default" 0.0; visible: 0; }
   description { state: "down" 0.0; inherit: "play" 0.0; image.normal: "thumb_down.svg"; }
}
part {
   name: "progress_bar_drag_glow"; type: VECTOR; scale: 1; mouse_events: 0;
   description {
      state: "default" 0.0; color: 255 255 255 0;
      rel1.to: "progress_bar_drag"; rel2.to: "progress_bar_drag";
      image.normal: "thumb_glow.svg";
   }
   description { state: "visible" 0.0; inherit: "default" 0.0; color: 255 255 255 255; }
}
part {
   name: "time_elapsed"; type: TEXT; scale: 1; mouse_events: 0;
   description {
      state: "default" 0.0; offset_scale: 1;
      rel1 { relative: 0 0; offset: 244 103; to: "body"; }
      rel2 { relative: 0 0; offset: 287 120; to: "body"; }
      color: THEME_INK;
      text { text: "0:00"; font: "Edje Vera"; size: 11; ellipsis: -1; }
   }
}
