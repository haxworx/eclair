part {
   name: "body";
   type: VECTOR;
   scale: 1;
   mouse_events: 0;
   description {
      state: "default" 0.0;
      offset_scale: 1;
      min: 306 340; max: 306 340;
      align: 0.5 0;
      rel1.offset: 21 14;
      rel2.offset: -22 -29;
      image.normal: "body.svg";
   }
}
part {
   name: "window_button_bar";
   type: RECT;
   scale: 1;
   mouse_events: 0;
   description {
      state: "default" 0.0; offset_scale: 1;
      color: 0 0 0 0;
      rel1 { relative: 0 0; offset: 242 0; to: "body"; }
      rel2 { relative: 0 0; offset: 293 19; to: "body"; }
   }
}
#define WINDOW_BUTTON(NAME, X) \
part { \
   name: NAME; type: VECTOR; scale: 1; \
   description { \
      state: "default" 0.0; offset_scale: 1; \
      rel1 { relative: 0 0; offset: X 1; to: "body"; } \
      rel2 { relative: 0 0; offset: (X + 19) 20; to: "body"; } \
      image.normal: NAME".svg"; \
   } \
   description { state: "down" 0.0; inherit: "default" 0.0; color: 180 180 180 255; } \
}
WINDOW_BUTTON("button_minimize", 246)
WINDOW_BUTTON("button_close", 270)

part {
   name: "brand"; type: TEXT; scale: 1; mouse_events: 0;
   description {
      state: "default" 0.0; offset_scale: 1;
      rel1 { relative: 0 0; offset: 23 7; to: "body"; }
      rel2 { relative: 0 0; offset: 170 24; to: "body"; }
      color: 143 94 66 255;
      text { text: "F O L I O   /   0 4"; font: "Sans"; size: 9; align: 0 0.5; }
   }
}
part {
   name: "platter"; type: VECTOR; scale: 1; mouse_events: 0;
   description {
      state: "default" 0.0; offset_scale: 1;
      rel1 { relative: 0 0; offset: 61 29; to: "body"; }
      rel2 { relative: 0 0; offset: 244 212; to: "body"; }
      image.normal: "platter.svg";

   }

}
part {
   name: "record_cover"; type: SWALLOW; scale: 1; mouse_events: 0;
   description {
      state: "default" 0.0; offset_scale: 1;
      rel1 { relative: 0 0; offset: 115 83; to: "body"; }
      rel2 { relative: 0 0; offset: 190 158; to: "body"; }
   }
}
part {
   name: "spindle"; type: VECTOR; scale: 1; mouse_events: 0;
   description {
      state: "default" 0.0; offset_scale: 1;
      rel1 { relative: 0 0; offset: 145 113; to: "body"; }
      rel2 { relative: 0 0; offset: 160 128; to: "body"; }
      image.normal: "spindle.svg";
   }
}
part {
   name: "tonearm"; type: VECTOR; scale: 1; mouse_events: 0;
   description {
      state: "default" 0.0; offset_scale: 1;
      rel1 { relative: 0 0; offset: 163 25; to: "body"; }
      rel2 { relative: 0 0; offset: 342 204; to: "body"; }
      image.normal: "tonearm.svg";
