part { name: "transport_clip"; type: RECT; mouse_events: 0; description { state: "default" 0.0; } }
part {
   name: "transport"; type: VECTOR; scale: 1; mouse_events: 0;
   description {
      state: "default" 0.0; offset_scale: 1;
      rel1 { relative: 0 0; offset: 20 272; to: "body"; }
      rel2 { relative: 0 0; offset: 285 301; to: "body"; }
      image.normal: "transport.svg";
   }
}
#define TRANSPORT_BUTTON(NAME, X, Y, SIZE, CLIP) \
part { \
   name: "button_"NAME; type: VECTOR; scale: 1; mouse_events: 0; clip_to: CLIP; \
   description { \
      state: "default" 0.0; offset_scale: 1; \
      rel1 { relative: 0 0; offset: X Y; to: "body"; } \
      rel2 { relative: 0 0; offset: (X + SIZE - 1) (Y + SIZE - 1); to: "body"; } \
      image.normal: "nav_"NAME".svg"; \
   } \
   description { state: "over" 0.0; inherit: "default" 0.0; image.normal: "nav_"NAME"_over.svg"; } \
   description { state: "down" 0.0; inherit: "default" 0.0; image.normal: "nav_"NAME"_down.svg"; } \
} \
part { \
   name: "button_"NAME"_rect"; type: RECT; scale: 1; \
   description { \
      state: "default" 0.0; offset_scale: 1; color: 0 0 0 0; \
      rel1 { to: "button_"NAME; offset: -2 -2; } \
      rel2 { to: "button_"NAME; offset: 1 1; } \
   } \
}
TRANSPORT_BUTTON("stop", 24, 276, 24, "transport_clip")
TRANSPORT_BUTTON("prev", 86, 276, 24, "transport_clip")
TRANSPORT_BUTTON("next", 196, 276, 24, "transport_clip")
TRANSPORT_BUTTON("open", 258, 276, 24, "transport_clip")
part {
   name: "play_surface"; type: VECTOR; scale: 1; mouse_events: 0;
   description {
      state: "default" 0.0; offset_scale: 1;
      rel1 { relative: 0 0; offset: 133 266; to: "body"; }
      rel2 { relative: 0 0; offset: 176 309; to: "body"; }
      image.normal: "play_surface.svg";
   }
}
TRANSPORT_BUTTON("play", 137, 270, 36, "play_clip")
part {
   name: "play_clip"; type: RECT; mouse_events: 0;
   description { state: "default" 0.0; }
   description { state: "play" 0.0; inherit: "default" 0.0; color: 255 255 255 0; }
}
/* The pause glyph is decorative; the shared center button toggles playback. */
part {
   name: "button_pause"; type: VECTOR; scale: 1; mouse_events: 0;
   description {
      state: "default" 0.0; visible: 0;
      rel1.to: "button_play"; rel2.to: "button_play";
      image.normal: "nav_pause.svg";
   }
   description { state: "play" 0.0; inherit: "default" 0.0; visible: 1; }
   description { state: "down" 0.0; inherit: "play" 0.0; image.normal: "nav_pause_down.svg"; }
}
part {
   name: "button_pause_rect"; type: RECT; scale: 1;
   description {
      state: "default" 0.0; visible: 0; color: 0 0 0 0;
      rel1.to: "button_play_rect"; rel2.to: "button_play_rect";
   }
   description { state: "play" 0.0; inherit: "default" 0.0; visible: 1; }
}
