   name: "playback_accent_2"; type: VECTOR; scale: 1; mouse_events: 0;
   description {
      state: "default" 0.0; offset_scale: 1;
      rel1 { to: "artwork_pane"; relative: 1 0; offset: -28 5; }
      rel2 { to: "artwork_pane"; relative: 1 0; offset: -11 22; }
      image.normal: "playback_accent.svg"; color: 255 255 255 40;
   }
   description {
      state: "lit" 0.0; inherit: "default" 0.0;
      rel1.offset: (-28 + ACCENT_DX) (5 + ACCENT_DY); rel2.offset: (-11 + ACCENT_DX) (22 + ACCENT_DY);
      color: 255 255 255 220;
   }
}
