/* A permanent queue, inside the same silhouette as the playback controls. */
part {
   name: "player_surface"; type: VECTOR; scale: 1; mouse_events: 0;
   description {
      state: "default" 0.0; offset_scale: 1;
      rel1 { to: "body"; }
      rel2 { to_x: "body"; relative: 1 1; offset: -1 -29; }
      image.normal: "body.svg";
   }
}
/* Artwork has its own permanent pane before the queue. */
part {
   name: "artwork_pane"; type: VECTOR; scale: 1; mouse_events: 0;
   description {
      state: "default" 0.0; offset_scale: 1;
      rel1 { to: "body"; relative: 0 1; offset: 12 12; }
      rel2 { to: "body"; relative: 1 1; offset: -13 207; }
      image.normal: "playlist_box.svg";
   }
}
part {
   name: "artwork_heading"; type: TEXT; scale: 1; mouse_events: 0;
   description {
      state: "default" 0.0; offset_scale: 1;
      rel1 { to: "artwork_pane"; offset: 10 4; }
      rel2 { to: "artwork_pane"; relative: 1 0; offset: -11 25; }
      color: THEME_INK;
      text { text: "Album artwork"; font: "Sans"; size: 10; align: 0 0.5; }
   }
}
part {
   name: "cover_placeholder"; type: VECTOR; scale: 1; mouse_events: 0;
   description {
      state: "default" 0.0; offset_scale: 1;
      min: 156 156; max: 156 156; align: 0.5 0;
      rel1 { to: "artwork_pane"; offset: 0 30; }
      rel2 { to: "artwork_pane"; offset: -1 -11; }
      image.normal: "cover.svg";
   }
   description { state: "covered" 0.0; inherit: "default" 0.0; visible: 0; }
}
part {
   name: "cover"; type: SWALLOW; scale: 1;
   description {
      state: "default" 0.0;
      rel1.to: "cover_placeholder"; rel2.to: "cover_placeholder";
   }
   description {
      state: "arrival" 0.0; inherit: "default" 0.0;
      color: 255 255 255 0;
   }
}
part {
   name: "playlist_background"; type: RECT; scale: 1; mouse_events: 0;
   description {
      state: "default" 0.0; offset_scale: 1; color: 0 0 0 0;
      rel1 { to_x: "body"; to_y: "artwork_pane"; relative: 0 1; offset: 12 4; }
      rel2 { to: "player_surface"; offset: -13 -13; }
   }
}
part {
   name: "playlist_heading"; type: TEXT; scale: 1; mouse_events: 0;
   description {
      state: "default" 0.0; offset_scale: 1;
      rel1 { to: "playlist_background"; offset: 4 0; }
      rel2 { to: "playlist_background"; relative: 1 0; offset: -5 23; }
      color: THEME_INK;
      text { text: "Playlist"; font: "Sans"; size: 10; align: 0 0.5; }
   }
}
part {
   name: "playlist_box"; type: VECTOR; scale: 1; mouse_events: 0;
   description {
      state: "default" 0.0; offset_scale: 1;
      rel1 { to: "playlist_background"; offset: 0 26; }
      rel2 { to: "playlist_background"; }
      image.normal: "playlist_box.svg";
   }
}
part {
   name: "playlist_clip"; type: RECT; mouse_events: 0;
   description {
      state: "default" 0.0;
      rel1.to: "playlist_box"; rel2.to: "playlist_box";
   }
}
part {
   name: "playlist_container"; type: SWALLOW; scale: 1; clip_to: "playlist_clip";
   description {
      state: "default" 0.0; offset_scale: 1;
      rel1 { to: "playlist_box"; offset: 10 10; }
      rel2 { to: "playlist_box"; offset: -27 -11; }
   }
}
