/* Silhouette shadows continue under rounded corners, without rectangular clips.
 * PNGs use 2x resolution and fixed nine-patch corners; see tools/theme-shadows.py.
 */
part {
   name: "body_drop"; type: IMAGE; scale: 1; mouse_events: 0;
   description {
      state: "default" 0.0; offset_scale: 1;
      color: 255 255 255 255;
      rel1 { relative: 0 0; offset: -27 -14; to: "body"; }
      rel2 { relative: 1 1; offset: 29 27; to: "player_surface"; }
      image.normal: "shadow_body.png";
      image.border: 96 96 96 96;
      image.border_scale: 1;
      image.border_scale_by: 0.5;
      fill.smooth: 1;
   }
}
