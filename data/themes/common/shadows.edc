/* Each PNG matches the fixed player silhouette at 2x.
 * Regenerate with src/bin/theme-shadows.py.
 */
part {
   name: "body_drop"; type: IMAGE; scale: 1; mouse_events: 0;
   description {
      state: "default" 0.0; offset_scale: 1;
      color: 255 255 255 255;
      rel1 { relative: 0 0; offset: 0 0; }
      rel2 { relative: 1 1; offset: -1 -1; }
      image.normal: "shadow_body.png";
      fill.smooth: 1;
   }
}
